<Application xmlns="http://xamarin.com/schemas/2014/forms"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="CompotClicker.App">
    <Application.Resources>
        <!-- Zasoby dla motywu jasnego -->
        <ResourceDictionary x:Key="LightTheme">
            <Color x:Key="BackgroundColor">White</Color>
            <Color x:Key="TextColor">Black</Color>
            <Color x:Key="ButtonBackgroundColor">#4CAF50</Color>
            <Color x:Key="ButtonTextColor">White</Color>
        </ResourceDictionary>

        <!-- Zasoby dla motywu ciemnego -->
        <ResourceDictionary x:Key="DarkTheme">
            <Color x:Key="BackgroundColor">#121212</Color>
            <Color x:Key="TextColor">White</Color>
            <Color x:Key="ButtonBackgroundColor">#6200EE</Color>
            <Color x:Key="ButtonTextColor">White</Color>
        </ResourceDictionary>

        <!-- Domyślnie ładowany motyw -->
        <ResourceDictionary Source="Style/LightTheme.xaml"/>
    </Application.Resources>
</Application>
